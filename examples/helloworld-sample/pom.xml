<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.sourcelume.examples</groupId>
  <artifactId>sourcelume-helloworld-sample</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Apache Sourcelume Hello World Sample</name>
  <description>Sample project demonstrating automated generation, validation, and submission of Sourcelume provenance records.</description>
  <url>https://sourcelume.apache.org/examples/helloworld</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <organization>
    <name>The Apache Software Foundation</name>
    <url>https://www.apache.org/</url>
  </organization>

  <developers>
    <developer>
      <id>developer</id>
      <name>Sourcelume Example Contributor</name>
      <email>dev@sourcelume.apache.org</email>
      <organization>Apache Sourcelume</organization>
      <roles>
        <role>originator</role>
      </roles>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/apache/sourcelume-tooling.git</connection>
    <developerConnection>scm:git:https://github.com/apache/sourcelume-tooling.git</developerConnection>
    <url>https://github.com/apache/sourcelume-tooling/tree/main/examples/helloworld-sample</url>
  </scm>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sourcelume.plugin.version>0.0.1-SNAPSHOT</sourcelume.plugin.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Compiler Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!-- Executable JAR configuration -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.apache.sourcelume.examples.HelloWorld</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Apache Sourcelume Maven Plugin -->
      <plugin>
        <groupId>org.apache.sourcelume</groupId>
        <artifactId>sourcelume-maven-plugin</artifactId>
        <version>${sourcelume.plugin.version}</version>
        <configuration>
          <registryUrl>http://localhost:8082</registryUrl>
          <licenseCategory>open-source</licenseCategory>
          <licenseNote>Apache-2.0 verified example dataset &amp; code</licenseNote>
          <datasetIdentifier>sourcelume://datasets/sample-helloworld-corpus-v1</datasetIdentifier>
          <datasetName>Sourcelume Hello World Example Dataset</datasetName>
        </configuration>
        <executions>
          <execution>
            <id>generate-sourcelume-spec</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
          <execution>
            <id>validate-sourcelume-spec</id>
            <phase>verify</phase>
            <goals>
              <goal>validate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
